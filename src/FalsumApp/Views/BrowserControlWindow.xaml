<Window x:Class="FalsumApp.Views.BrowserControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browser Control" Height="600" Width="900"
        Background="#1A1A2E" Foreground="#EEEEEE"
        FontFamily="Segoe UI Variable" WindowStartupLocation="CenterScreen">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Browser Control" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock Text="Greyed-out settings mean something is controlling your browser. Take it back."
                       FontSize="13" Foreground="#A0A0A0" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Policy list -->
        <Border Grid.Row="1" Background="#16213E" CornerRadius="12" Padding="16"
                BorderBrush="#2A2A4A" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button x:Name="ScanButton" Content="Scan for Policies"
                            Click="ScanButton_Click" Margin="0,0,12,0"
                            Background="#E94560" Foreground="White"
                            Padding="16,8" BorderThickness="0" Cursor="Hand"/>
                    <TextBlock x:Name="PolicyCount" Text="Click Scan to check your browser."
                               VerticalAlignment="Center" Foreground="#A0A0A0" FontSize="13"/>
                </StackPanel>

                <ListView Grid.Row="1" x:Name="PolicyList" Background="Transparent"
                          BorderThickness="0" Foreground="#EEEEEE">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1E2A4A" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Description}" FontSize="14"
                                               FontWeight="SemiBold" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                                    <TextBlock FontSize="12" Foreground="#A0A0A0" Margin="0,4,0,0">
                                        <Run Text="{Binding Name}"/>
                                        <Run Text=" = "/>
                                        <Run Text="{Binding Value}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="#666666" Margin="0,2,0,0">
                                        <Run Text="{Binding Hive}"/>
                                        <Run Text="\"/>
                                        <Run Text="{Binding Path}"/>
                                        <Run Text=" ("/>
                                        <Run Text="{Binding Scope}"/>
                                        <Run Text=")"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="RemoveButton" Content="Remove All Policies (Unlock My Browser)"
                    Click="RemoveButton_Click" IsEnabled="False"
                    Background="#E94560" Foreground="White" FontWeight="SemiBold"
                    Padding="20,10" BorderThickness="0" Cursor="Hand" Margin="0,0,12,0"/>
            <Button Content="Close" Click="CloseButton_Click"
                    Background="#2A2A4A" Foreground="#EEEEEE"
                    Padding="20,10" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
