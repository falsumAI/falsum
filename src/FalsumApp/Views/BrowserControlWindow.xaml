<Window x:Class="FalsumApp.Views.BrowserControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Take Back Control" Height="650" Width="950"
        Background="#1A1A2E" Foreground="#EEEEEE"
        FontFamily="Segoe UI Variable" WindowStartupLocation="CenterScreen">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Take Back Control" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock Text="Greyed-out settings and 'your organization' blocks mean policies are controlling your computer. Find them. Remove them."
                       FontSize="13" Foreground="#A0A0A0" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="#A0A0A0"/>
                    <Setter Property="Background" Value="#16213E"/>
                    <Setter Property="Padding" Value="16,8"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="Background" Value="#1E2A4A"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <!-- Browser Policies -->
            <TabItem Header="Browser">
                <Border Background="#16213E" CornerRadius="12" Padding="16"
                        BorderBrush="#2A2A4A" BorderThickness="1" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <Button x:Name="ScanButton" Content="Scan Browser Policies" AutomationProperties.Name="Scan Browser Policies" AutomationProperties.HelpText="Scan Chrome and Edge for enterprise policies that may be restricting your browser."
                                    Click="ScanButton_Click" Margin="0,0,12,0"
                                    Background="#E94560" Foreground="White"
                                    Padding="16,8" BorderThickness="0" Cursor="Hand"/>
                            <TextBlock x:Name="PolicyCount" Text="Click Scan to check your browser."
                                       VerticalAlignment="Center" Foreground="#A0A0A0" FontSize="13"/>
                        </StackPanel>
                        <ListView Grid.Row="1" x:Name="PolicyList" Background="Transparent"
                                  BorderThickness="0" Foreground="#EEEEEE">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E2A4A" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="14"
                                                       FontWeight="SemiBold" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                                            <TextBlock FontSize="12" Foreground="#A0A0A0" Margin="0,4,0,0">
                                                <Run Text="{Binding Name}"/><Run Text=" = "/><Run Text="{Binding Value}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="#666666" Margin="0,2,0,0">
                                                <Run Text="{Binding Hive}"/><Run Text="\"/><Run Text="{Binding Path}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Windows System Policies -->
            <TabItem Header="Windows System">
                <Border Background="#16213E" CornerRadius="12" Padding="16"
                        BorderBrush="#2A2A4A" BorderThickness="1" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button x:Name="ScanSysButton" Content="Scan System Policies" AutomationProperties.Name="Scan System Policies" AutomationProperties.HelpText="Scan Windows system policies."
                                        Click="ScanSysButton_Click" Margin="0,0,12,0"
                                        Background="#E94560" Foreground="White"
                                        Padding="16,8" BorderThickness="0" Cursor="Hand"/>
                                <TextBlock x:Name="SysPolicyCount" Text="Finds 'your organization' download/install blocks."
                                           VerticalAlignment="Center" Foreground="#A0A0A0" FontSize="13"/>
                            </StackPanel>
                            <TextBlock Text="This is what blocks Codex downloads and greys out Windows settings."
                                       FontSize="12" Foreground="#666666" FontStyle="Italic"/>
                        </StackPanel>
                        <ListView Grid.Row="1" x:Name="SysPolicyList" Background="Transparent"
                                  BorderThickness="0" Foreground="#EEEEEE">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E2A4A" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="14"
                                                       FontWeight="SemiBold" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                                            <TextBlock FontSize="12" Foreground="#A0A0A0" Margin="0,4,0,0">
                                                <Run Text="{Binding Name}"/><Run Text=" = "/><Run Text="{Binding Value}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="#666666" Margin="0,2,0,0">
                                                <Run Text="{Binding Hive}"/><Run Text="\"/><Run Text="{Binding Path}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Category}" FontSize="11"
                                                       Foreground="#E94560" Margin="0,2,0,0" FontStyle="Italic"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="RemoveButton" Content="Remove All Policies" AutomationProperties.Name="Remove All Policies" AutomationProperties.HelpText="Remove all detected browser policies. Requires administrator."
                    Click="RemoveButton_Click" IsEnabled="False"
                    Background="#E94560" Foreground="White" FontWeight="SemiBold"
                    Padding="20,10" BorderThickness="0" Cursor="Hand" Margin="0,0,12,0"/>
            <Button Content="Close" Click="CloseButton_Click"
                    Background="#2A2A4A" Foreground="#EEEEEE"
                    Padding="20,10" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
