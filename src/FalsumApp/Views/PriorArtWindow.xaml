<Window x:Class="FalsumApp.Views.PriorArtWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prior Art Vault" Height="700" Width="900"
        Background="#1A1A2E" Foreground="#EEEEEE"
        FontFamily="Segoe UI Variable" WindowStartupLocation="CenterScreen">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Prior Art Vault" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock Text="Publish your inventions with timestamped, hash-chained proof. Your name is cryptographically bound — it can never be stripped. If they patent around your work after this date, this vault invalidates their patent."
                       FontSize="13" Foreground="#A0A0A0" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Publish new invention -->
        <Border Grid.Row="1" Background="#16213E" CornerRadius="12" Padding="16"
                BorderBrush="#2A2A4A" BorderThickness="1" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Title:" VerticalAlignment="Center" Foreground="#A0A0A0"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TitleBox" Background="#1E2A4A"
                         Foreground="White" BorderThickness="0" Padding="8" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Inventor:" VerticalAlignment="Center" Foreground="#A0A0A0"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="InventorBox" Background="#1E2A4A"
                         Foreground="White" BorderThickness="0" Padding="8" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Description:" VerticalAlignment="Top" Foreground="#A0A0A0" Margin="0,8,0,0"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="DescriptionBox" Background="#1E2A4A"
                         Foreground="White" BorderThickness="0" Padding="8" Margin="0,0,0,8"
                         TextWrapping="Wrap" AcceptsReturn="True" Height="80"/>

                <Button Grid.Row="3" Grid.Column="1" Content="Publish as Prior Art"
                        Click="PublishButton_Click" HorizontalAlignment="Left"
                        Background="#E94560" Foreground="White" FontWeight="SemiBold"
                        Padding="20,10" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Existing records -->
        <Border Grid.Row="2" Background="#16213E" CornerRadius="12" Padding="16"
                BorderBrush="#2A2A4A" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Published Inventions" FontSize="16" FontWeight="SemiBold"
                               Foreground="White" VerticalAlignment="Center"/>
                    <Button x:Name="VerifyButton" Content="Verify Chain" Click="VerifyButton_Click"
                            Margin="16,0,0,0" Background="#2A2A4A" Foreground="#EEEEEE"
                            Padding="12,6" BorderThickness="0" Cursor="Hand"/>
                    <TextBlock x:Name="VerifyResult" Margin="12,0,0,0" VerticalAlignment="Center"
                               FontSize="13" Foreground="#A0A0A0"/>
                </StackPanel>
                <ListView Grid.Row="1" x:Name="RecordsList" Background="Transparent"
                          BorderThickness="0" Foreground="#EEEEEE">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1E2A4A" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="15"
                                               FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBlock Margin="0,4,0,0" FontSize="13" Foreground="#A0A0A0" TextWrapping="Wrap">
                                        <Run Text="Inventor: "/><Run Text="{Binding InventorName}" FontWeight="SemiBold" Foreground="#4CAF50"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Description}" FontSize="12"
                                               Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,4,0,0" MaxHeight="60"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="11" Foreground="#666666" Margin="0,4,0,0">
                                        <Run Text="Published: "/><Run Text="{Binding PublishedAt}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="10" Foreground="#444444" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis">
                                        <Run Text="Hash: "/><Run Text="{Binding RecordHash}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Margin="0,16,0,0" FontSize="11" Foreground="#666666"
                   TextWrapping="Wrap" TextAlignment="Center"
                   Text="Every record is hash-chained and timestamped. Export any record as a USPTO prior art declaration."/>
    </Grid>
</Window>
