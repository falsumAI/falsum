<Window x:Class="FalsumApp.Views.PortConsentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Falsum: Network Consent" Height="280" Width="480"
        WindowStartupLocation="CenterScreen" Topmost="True"
        ResizeMode="NoResize" ShowInTaskbar="True">
    <StackPanel Margin="18">
        <TextBlock Text="An application tried to use the network."
                   FontWeight="Bold" FontSize="14" Margin="0,0,0,8"
                   AutomationProperties.Name="Network consent request"/>
        <TextBlock x:Name="AppText" TextWrapping="Wrap" Margin="0,0,0,4"
                   AutomationProperties.Name="Application name and path"/>
        <TextBlock x:Name="DestText" TextWrapping="Wrap" Margin="0,0,0,12"
                   AutomationProperties.Name="Destination address and port"/>
        <TextBlock Text="Nothing leaves this machine without your consent. No answer means Block."
                   FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,14"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="AllowAlwaysButton" Content="Allow always" Width="104" Margin="0,0,8,0"
                    Click="AllowAlwaysButton_Click"
                    AutomationProperties.Name="Allow this application always"
                    AutomationProperties.HelpText="Creates a permanent firewall allow rule for this application."/>
            <Button x:Name="AllowOnceButton" Content="Allow once" Width="104" Margin="0,0,8,0"
                    Click="AllowOnceButton_Click"
                    AutomationProperties.Name="Allow this application once"
                    AutomationProperties.HelpText="Allows this time only. The rule is removed when consent mode turns off."/>
            <Button x:Name="BlockButton" Content="Block" Width="104" IsDefault="True"
                    Click="BlockButton_Click"
                    AutomationProperties.Name="Block this application"
                    AutomationProperties.HelpText="Blocks the application and marks it permanently."/>
        </StackPanel>
    </StackPanel>
</Window>
