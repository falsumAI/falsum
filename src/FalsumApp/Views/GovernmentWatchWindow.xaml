<Window x:Class="FalsumApp.Views.GovernmentWatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Government AI Watch" Height="750" Width="1000"
        Background="#1A1A2E" Foreground="#EEEEEE"
        FontFamily="Segoe UI Variable" WindowStartupLocation="CenterScreen">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Government AI Watch" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock Text="97% of OECD countries use AI in government. Every sector that serves you can surveil you. Falsum watches the watchers."
                       FontSize="13" Foreground="#A0A0A0" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="SectorList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#16213E" CornerRadius="12" Padding="20" Margin="0,0,0,16"
                                BorderBrush="#2A2A4A" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="40"
                                           VerticalAlignment="Top" HorizontalAlignment="Center"/>

                                <StackPanel Grid.Column="1" Margin="12,0">
                                    <TextBlock Text="{Binding Name}" FontSize="18"
                                               FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="13">
                                        <Run Text="They use: " FontWeight="SemiBold" Foreground="#A0A0A0"/>
                                        <Run Text="{Binding GovernmentUse}" Foreground="#CCCCCC"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="13">
                                        <Run Text="Threat: " FontWeight="SemiBold" Foreground="#E94560"/>
                                        <Run Text="{Binding Threat}" Foreground="#CCCCCC"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="13">
                                        <Run Text="Falsum: " FontWeight="SemiBold" Foreground="#4CAF50"/>
                                        <Run Text="{Binding FalsumProtection}" Foreground="#CCCCCC"/>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding ProtectiveModules}" Margin="0,8,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1E2A4A" CornerRadius="16"
                                                        Padding="12,4" Margin="0,0,8,4">
                                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="#A0A0A0"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <Button Grid.Column="2" Content="{Binding ActionLabel}" AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Description}"
                                        Tag="{Binding}" Click="SectorAction_Click"
                                        Background="#E94560" Foreground="White"
                                        Padding="16,10" BorderThickness="0" Cursor="Hand"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Margin="0,16,0,0" FontSize="12" Foreground="#666666"
                   TextWrapping="Wrap" TextAlignment="Center"
                   Text="The government has AI. Now you do too — free, local, and yours. Falsum never sends your data anywhere."/>
    </Grid>
</Window>
