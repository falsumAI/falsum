<Window x:Class="FalsumApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:FalsumApp.Converters"
        Title="Falsum" Height="900" Width="1400"
        Background="#0A0A14" Foreground="#FFFFFF"
        FontFamily="Segoe UI Variable" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:IconKeyConverter x:Key="IconConverter"/>
        <conv:BrushKeyConverter x:Key="BrushConverter"/>
        <!-- ============ VECTOR ICONS (no emoji — pure geometry, sharp at any size) ============ -->

        <PathGeometry x:Key="IconShield">M12,2 L20,6 V11 C20,16 16.5,19.5 12,21 C7.5,19.5 4,16 4,11 V6 Z</PathGeometry>
        <PathGeometry x:Key="IconLock">M12,2 C9.2,2 7,4.2 7,7 V10 H6 C4.9,10 4,10.9 4,12 V20 C4,21.1 4.9,22 6,22 H18 C19.1,22 20,21.1 20,20 V12 C20,10.9 19.1,10 18,10 H17 V7 C17,4.2 14.8,2 12,2 Z M12,13.5 C13.4,13.5 14.5,14.6 14.5,16 C14.5,16.8 14.1,17.4 13.5,17.8 L13.5,20 L10.5,20 L10.5,17.8 C9.9,17.4 9.5,16.8 9.5,16 C9.5,14.6 10.6,13.5 12,13.5 Z</PathGeometry>
        <PathGeometry x:Key="IconEye">M12,5 C6,5 1.7,12 1.7,12 C1.7,12 6,19 12,19 C18,19 22.3,12 22.3,12 C22.3,12 18,5 12,5 Z M12,9 C10.3,9 9,10.3 9,12 C9,13.7 10.3,15 12,15 C13.7,15 15,13.7 15,12 C15,10.3 13.7,9 12,9 Z</PathGeometry>
        <PathGeometry x:Key="IconNetwork">M12,2 A3,3 0 1,0 12,8 A3,3 0 1,0 12,2 Z M5,10 A3,3 0 1,0 5,16 A3,3 0 1,0 5,10 Z M19,10 A3,3 0 1,0 19,16 A3,3 0 1,0 19,10 Z M12,16 A3,3 0 1,0 12,22 A3,3 0 1,0 12,16 Z M10.5,7.5 L6.8,10.2 M13.5,7.5 L17.2,10.2 M6.8,15.8 L10.5,17.5 M17.2,15.8 L13.5,17.5</PathGeometry>
        <PathGeometry x:Key="IconGear">M12,8 A4,4 0 1,0 12,16 A4,4 0 1,0 12,8 Z M19.5,13.5 C19.3,14.5 18.9,15.4 18.3,16.2 L19.5,17.8 L17.8,19.5 L16.2,18.3 C15.4,18.9 14.5,19.3 13.5,19.5 L13.2,21.2 L10.8,21.2 L10.5,19.5 C9.5,19.3 8.6,18.9 7.8,18.3 L6.2,19.5 L4.5,17.8 L5.7,16.2 C5.1,15.4 4.7,14.5 4.5,13.5 L2.8,13.2 L2.8,10.8 L4.5,10.5 C4.7,9.5 5.1,8.6 5.7,7.8 L4.5,6.2 L6.2,4.5 L7.8,5.7 C8.6,5.1 9.5,4.7 10.5,4.5 L10.8,2.8 L13.2,2.8 L13.5,4.5 C14.5,4.7 15.4,5.1 16.2,5.7 L17.8,4.5 L19.5,6.2 L18.3,7.8 C18.9,8.6 19.3,9.5 19.5,10.5 L21.2,10.8 L21.2,13.2 Z</PathGeometry>
        <PathGeometry x:Key="IconSearch">M10,2 A8,8 0 1,0 10,18 A8,8 0 1,0 10,2 Z M10,4 A6,6 0 1,1 10,16 A6,6 0 1,1 10,4 Z M15.5,15.5 L21.5,21.5 L20,23 L14,17 Z</PathGeometry>
        <PathGeometry x:Key="IconChat">M4,2 H20 C21.1,2 22,2.9 22,4 V14 C22,15.1 21.1,16 20,16 H12 L8,20 V16 H4 C2.9,16 2,15.1 2,14 V4 C2,2.9 2.9,2 4,2 Z</PathGeometry>
        <PathGeometry x:Key="IconDoc">M6,2 H14 L20,8 V20 C20,21.1 19.1,22 18,22 H6 C4.9,22 4,21.1 4,20 V4 C4,2.9 4.9,2 6,2 Z M8,12 H16 V14 H8 Z M8,15.5 H16 V17.5 H8 Z</PathGeometry>
        <PathGeometry x:Key="IconAlert">M12,2 L22,20 H2 Z M11,8.5 V13.5 H13 V8.5 Z M11,15.5 V17.5 H13 V15.5 Z</PathGeometry>
        <PathGeometry x:Key="IconCheck">M12,2 A10,10 0 1,0 12,22 A10,10 0 1,0 12,2 Z M10.5,16.5 L6,12 L7.4,10.6 L10.5,13.7 L16.6,7.6 L18,9 Z</PathGeometry>
        <PathGeometry x:Key="IconBolt">M13,2 L4,14 H11 L9,22 L20,9 H13 Z</PathGeometry>
        <PathGeometry x:Key="IconGlobe">M12,2 A10,10 0 1,0 12,22 A10,10 0 1,0 12,2 Z M12,4 C14,4 15.5,7 15.5,12 C15.5,17 14,20 12,20 C10,20 8.5,17 8.5,12 C8.5,7 10,4 12,4 Z M3.5,10.5 H20.5 M3.5,13.5 H20.5</PathGeometry>
        <PathGeometry x:Key="IconKey">M15,2 A5.5,5.5 0 0,0 10.8,11.2 L9,13 L9,15 L11,15 L11,17 L9,17 L9,19 L11,19 L11,22 L13,22 L13,19 L15,19 L15,17 L13,17 L13,15 L15,15 L15,13 L13.8,13 A5.5,5.5 0 0,0 15,2 Z M15,4.5 A3,3 0 1,1 15,10.5 A3,3 0 1,1 15,4.5 Z</PathGeometry>
        <PathGeometry x:Key="IconChip">M9,2 V4 H7 C5.9,4 5,4.9 5,6 V18 C5,19.1 5.9,20 7,20 H17 C18.1,20 19,19.1 19,18 V6 C19,4.9 18.1,4 17,4 H15 V2 H13 V4 H11 V2 Z M7,6 H17 V18 H7 Z M10,9 V15 H14 V9 Z</PathGeometry>

        <!-- ============ CATEGORY COLORS ============ -->
        <SolidColorBrush x:Key="CatProtection" Color="#E94560"/>
        <SolidColorBrush x:Key="CatPrivacy" Color="#0F9D58"/>
        <SolidColorBrush x:Key="CatNetwork" Color="#1A73E8"/>
        <SolidColorBrush x:Key="CatControl" Color="#F9AB00"/>
        <SolidColorBrush x:Key="CatInvestigate" Color="#9C27B0"/>

        <!-- ============ PREMIUM CARD ============ -->
        <Style x:Key="FalsumCardButton" TargetType="Button">
            <Setter Property="Background" Value="#12121F"/>
            <Setter Property="BorderBrush" Value="#1E1E35"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="Height" Value="210"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.45" BlurRadius="14" ShadowDepth="5"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#E94560"/>
                    <Setter Property="Background" Value="#1A1A2E"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#E94560"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0F0F1E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="CardDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#8A8AA0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>

        <Style x:Key="CategoryLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1A2E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2A2A4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#25253E"/>
                    <Setter Property="BorderBrush" Value="#E94560"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProtectButton" TargetType="Button">
            <Setter Property="Background" Value="#E94560"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="44,15"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#E94560" Opacity="0.4" BlurRadius="22" ShadowDepth="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F05570"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#C93A52"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8A8AA0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,13"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="Background" Value="#1A1A2E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- ============ LEFT SIDEBAR ============ -->
        <Border Grid.Column="0" Grid.Row="0" Background="#0C0C18" BorderBrush="#1E1E35" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,28,0,0">
                <StackPanel Margin="22,0,22,36" Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="22" Background="#E94560" Margin="0,0,14,0">
                        <Path Data="{StaticResource IconShield}" Fill="White" Width="26" Height="26"
                              Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="FALSUM" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="v1.1.0" FontSize="11" Foreground="#8A8AA0"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="PROTECTION" Style="{StaticResource CategoryLabel}" Foreground="{StaticResource CatProtection}" Margin="22,0,22,4"/>
                <Button Content="Protect Me" Style="{StaticResource NavItem}" Click="ProtectAll_Click"
                        AutomationProperties.Name="Protect Me — run all security checks"/>
                <Button Content="System Bubble" Style="{StaticResource NavItem}"
                        AutomationProperties.Name="System Bubble"/>
                <Button Content="Firewall" Style="{StaticResource NavItem}"
                        AutomationProperties.Name="Firewall Control"/>

                <TextBlock Text="PRIVACY" Style="{StaticResource CategoryLabel}" Foreground="{StaticResource CatPrivacy}" Margin="22,18,22,4"/>
                <Button Content="Predator Vault" Style="{StaticResource NavItem}"
                        AutomationProperties.Name="Predator Vault"/>
                <Button Content="Data Brokers" Style="{StaticResource NavItem}"
                        AutomationProperties.Name="Data Broker Eradicator"/>

                <TextBlock Text="INTELLIGENCE" Style="{StaticResource CategoryLabel}" Foreground="{StaticResource CatInvestigate}" Margin="22,18,22,4"/>
                <Button Content="AI Chat" Style="{StaticResource NavItem}" Click="OpenAIChat_Click"
                        AutomationProperties.Name="Open AI Chat"/>
                <Button Content="Investigate" Style="{StaticResource NavItem}"
                        AutomationProperties.Name="Investigation tools"/>

                <TextBlock Text="SYSTEM" Style="{StaticResource CategoryLabel}" Foreground="{StaticResource CatControl}" Margin="22,18,22,4"/>
                <Button Content="Settings" Style="{StaticResource NavItem}" Click="OpenSettings_Click"
                        AutomationProperties.Name="Open Settings"/>

                <Border Margin="22,36,22,0" Background="#12121F" CornerRadius="14" Padding="18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="10" Height="10" Fill="#4CAF50" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="PROTECTED" FontSize="14" FontWeight="Bold" Foreground="#4CAF50"/>
                        </StackPanel>
                        <TextBlock Text="63 modules active" FontSize="12" Foreground="#8A8AA0"/>
                        <TextBlock Text="All native · Zero cloud" FontSize="12" Foreground="#8A8AA0" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ============ MAIN CONTENT ============ -->
        <Grid Grid.Column="1" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0C0C18" BorderBrush="#1E1E35" BorderThickness="0,0,0,1" Padding="36,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Security Command Center" FontSize="30" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Every module protects your computer and your data. Nothing leaves this machine."
                                   FontSize="14" Foreground="#8A8AA0" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="PROTECT ME" Style="{StaticResource ProtectButton}"
                            Click="ProtectAll_Click" VerticalAlignment="Center"
                            AutomationProperties.Name="Protect Me — run all security checks now"/>
                </Grid>
            </Border>

            <!-- Module cards: vector icon in category-colored badge, no emoji -->
            <ScrollViewer Grid.Row="1" Margin="36,28" VerticalScrollBarVisibility="Auto"
                          AutomationProperties.Name="Security modules">
                <ItemsControl x:Name="ModuleCards" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource FalsumCardButton}" Margin="10"
                                    Click="ModuleCard_Click" Tag="{Binding}"
                                    AutomationProperties.Name="{Binding Title}"
                                    AutomationProperties.HelpText="{Binding Description}">
                                <StackPanel>
                                    <Border Width="54" Height="54" CornerRadius="27"
                                            Background="{Binding CategoryBrushKey, Converter={StaticResource BrushConverter}}"
                                            HorizontalAlignment="Left" Margin="0,0,0,14">
                                        <Path Data="{Binding IconKey, Converter={StaticResource IconConverter}}" Fill="White"
                                              Width="28" Height="28" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding Category}" Style="{StaticResource CategoryLabel}"
                                               Foreground="{Binding CategoryBrushKey, Converter={StaticResource BrushConverter}}"/>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource CardDesc}"
                                               MaxHeight="60" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#0C0C18" BorderBrush="#1E1E35" BorderThickness="0,1,0,0" Padding="36,14">
                <StackPanel>
                    <TextBlock Text="BROWSER GATE" FontSize="11" FontWeight="Bold" Foreground="#E94560" Margin="0,0,0,8"/>
                    <ListBox x:Name="BrowserFeedList" MaxHeight="90" Background="#12121F" Foreground="#CCCCCC"
                             BorderBrush="#1E1E35" BorderThickness="1" FontSize="12"
                             AutomationProperties.Name="Browser gate activity feed"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ STATUS BAR ============ -->
        <Border Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" Background="#0C0C18" BorderBrush="#1E1E35" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Margin="22,0" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#4CAF50" Margin="0,0,12,0"/>
                <TextBlock x:Name="StatusText" Text="Falsum is watching. Your data never leaves this computer."
                           FontSize="12" Foreground="#8A8AA0"
                           AutomationProperties.Name="Status" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
