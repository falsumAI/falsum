<Window x:Class="FalsumApp.Views.ResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Falsum Results" Height="480" Width="640"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <TextBlock x:Name="TitleText" DockPanel.Dock="Top" FontSize="16" FontWeight="Bold"
                   Margin="0,0,0,8" Text="Results"
                   AutomationProperties.Name="Results title"/>
        <Button x:Name="CloseButton" DockPanel.Dock="Bottom" Content="Close"
                HorizontalAlignment="Right" Margin="0,8,0,0" Padding="24,6"
                Click="CloseButton_Click"
                AutomationProperties.Name="Close results"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ResultsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="4"
                                Margin="0,0,0,8" Padding="10">
                            <StackPanel>
                                <TextBlock Text="{Binding Header}" FontWeight="Bold" FontSize="13"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           AutomationProperties.Name="Result details"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
