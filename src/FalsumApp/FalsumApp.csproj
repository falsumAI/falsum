<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <AssemblyName>Falsum</AssemblyName>
    <RootNamespace>FalsumApp</RootNamespace>
    <Version>1.1.0</Version>
    <Authors>Gregg Haynes</Authors>
    <Description>Free local security. No subscriptions. No cloud. No lies.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- ETW real-time tracing for the system-wide bubble (process/network/file) -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.*" />
    <!-- WMI access for Defender status (what the Get-Mp* cmdlets wrap) -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
