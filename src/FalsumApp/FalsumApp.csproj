<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Falsum</AssemblyName>
    <RootNamespace>FalsumApp</RootNamespace>
    <Version>1.1.0</Version>
    <Authors>Gregg Haynes</Authors>
    <Description>Free local security. No subscriptions. No cloud. No lies.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- ETW real-time tracing for the system-wide bubble (process/network/file) -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.*" />
    <!-- WMI access for Defender status (what the Get-Mp* cmdlets wrap) -->
    <PackageReference Include="System.Management" Version="8.0.0" />
    <!-- DPAPI for vault encryption keys -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- Explicit usings: the WPF cross-compile temp project doesn't inherit ImplicitUsings -->
  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Text" />
    <Using Include="System.Text.Json" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Net.Http" />
    <Using Include="System.Text.RegularExpressions" />
  </ItemGroup>

</Project>
