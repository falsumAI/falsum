{
  "action": {
    "default_popup": "popup.html",
    "default_title": "Falsum"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "all_frames": true,
      "js": [
        "content.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_start"
    }
  ],
  "description": "Falsum Browser Bubble: the browser runs inside Falsum. This extension is the inner eye \u2014 the desktop app is the gate. Captures downloads, navigation, requests, fingerprinting.",
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "name": "Falsum",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "webNavigation",
    "webRequest",
    "storage",
    "alarms",
    "downloads",
    "cookies",
    "notifications"
  ],
  "version": "2.0.0"
}