<?xml version="1.0" encoding="utf-8"?>
<!--
    Falsum Android manifest.
    No Google Play Services, no Firebase, no analytics receivers.
    Distributed as a free APK outside the Play Store / F-Droid compatible.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Local VPN filtering. No root required. All filtering on-device. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Declared for API 34+; harmlessly ignored on older releases. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Needed on API 30+ to enumerate installed packages for the
         permission audit and stalkerware scan. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:label="Falsum"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".FalsumVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <!-- Required on API 34+ for specialUse foreground services.
                 Ignored on older releases. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local on-device network filtering for tracker blocking. Filtering decisions never leave the device." />
        </service>

    </application>
</manifest>
